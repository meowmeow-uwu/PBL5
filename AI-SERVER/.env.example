# --- CẤU HÌNH AI SERVER (FLASK) ---
AI_HOST=0.0.0.0
AI_PORT=5000

# --- CẤU HÌNH WEB BACKEND API ---
# Địa chỉ API của Backend (NodeJS/Java Spring Boot) để đẩy dữ liệu kết quả phân loại lên
BACKEND_API_URL=http://localhost:8080/api/fruit

# --- CẤU HÌNH MINIO STORAGE ---
# Địa chỉ endpoint của máy chủ lưu trữ ảnh MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=12345678
MINIO_BUCKET=tomato-images

# --- CẤU HÌNH MÔ HÌNH NHẬN DIỆN (MODEL) ---
# Đường dẫn tới tệp tin trọng số mô hình PyTorch (.pth)
MODEL_PATH=../results/transfer_save_model/transfer_cnn_best.pth

# Kích thước ảnh đầu vào của mô hình (InceptionV3 mặc định là 299)
IMG_SIZE=299

# Danh sách các nhãn phân lớp phân tách bằng dấu phẩy (lưu ý giữ đúng thứ tự chỉ mục lúc train)
CLASS_NAMES=Reject,Ripe,Unripe
